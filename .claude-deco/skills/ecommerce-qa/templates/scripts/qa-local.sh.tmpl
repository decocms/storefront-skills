#!/usr/bin/env bash
# Run the QA purchase journey against a local or remote URL with browser visible.
#
# Usage:
#   ./scripts/qa-local.sh                     # localhost:8000 (default dev server)
#   ./scripts/qa-local.sh http://localhost:3000
#   ./scripts/qa-local.sh https://staging.example.com
#
# Tips:
#   - Add --debug to pause at each step for inspection (already enabled below).
#   - Remove --headed to run headless (faster).
#   - Add --smoke for a fast run (no checkout): bunx @decocms/qa@latest journey --url <url> --smoke
#
# This is a local-debug convenience only. The real QA run happens on the deco
# control-plane (k8s Job on PR previews) and reports a GitHub Check Run.

set -euo pipefail

TARGET_URL="${1:-http://localhost:8000}"

echo "Running QA journey against: $TARGET_URL"
echo "  Config: .qarc.json"
echo "  Mode: headed + debug (pauses at each step)"
echo ""

bunx @decocms/qa@latest journey \
  --url "$TARGET_URL" \
  --headed \
  --debug
