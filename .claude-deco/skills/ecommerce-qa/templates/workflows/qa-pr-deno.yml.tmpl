name: QA (PR preview)

# Runs the @decocms/qa purchase journey against the decobot deco preview link.
# The engine (>=0.5.0) sends a `deco-qa-bot/1.0` token in its User-Agent so a
# single Cloudflare WAF allowlist (scoped to *.decocdn.com) can let the QA bot
# through preview bot-protection without weakening it for real traffic.

on:
  pull_request:
    types: [opened, synchronize, reopened]
  workflow_dispatch:
    inputs:
      url:
        description: Manual override (skip decobot polling)
        required: false
        type: string

concurrency:
  group: qa-${{ github.event.pull_request.number || github.run_id }}
  cancel-in-progress: true

jobs:
  e2e:
    name: Purchase journey
    runs-on: ubuntu-latest
    timeout-minutes: 20

    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Setup Deno
        uses: denoland/setup-deno@v1
        with:
          deno-version: v2.x

      # @decocms/qa runs Playwright under Deno but does not ship browser binaries.
      # Install the Chromium build matching the playwright version the engine resolves
      # (its dependency range), so the revision matches what the engine launches.
      - name: Install Playwright browsers (matching engine)
        run: |
          PW=$(npm view @decocms/qa@{{ENGINE_VERSION}} dependencies.playwright)
          echo "Engine playwright range: $PW"
          npx --yes "playwright@$PW" install --with-deps chromium chromium-headless-shell

      - name: Wait for deco preview
        id: preview
        if: github.event_name == 'pull_request'
        uses: actions/github-script@v7
        with:
          retries: 3
          script: |
            const PR_NUMBER = context.issue.number;
            const TIMEOUT_MS = 10 * 60 * 1000;
            const POLL_INTERVAL_MS = 20_000;
            // Match either the visible "[Visit Preview](URL)" link OR the
            // HTML-comment marker style "<!-- deco-pr-comment ... -->" with
            // an embedded URL on common deco hosts.
            const URL_REGEX = /\[Visit Preview\]\((https?:\/\/[^\s)]+)\)|https?:\/\/[^\s"<]+\.(?:workers\.dev|decocdn\.com|deco\.site|deco-cx\.com)\b[^\s"<]*/;
            const READY_REGEX = /Ready|ready|✅|deco-pr-comment/;
            const BOT_LOGINS = new Set(['decobot', 'deco-bot', 'decocms-bot', 'github-actions[bot]']);

            const deadline = Date.now() + TIMEOUT_MS;
            let previewUrl = null;

            while (Date.now() < deadline) {
              const { data: comments } = await github.rest.issues.listComments({
                owner: context.repo.owner,
                repo: context.repo.repo,
                issue_number: PR_NUMBER,
                per_page: 100,
              });

              // SECURITY: trust ONLY comments authored by the deco bot accounts.
              // Do NOT also accept a comment because its body contains
              // "deco-pr-comment" — any commenter could then post a crafted
              // "Ready" + [Visit Preview](url) and redirect the journey to an
              // attacker host. BOT_LOGINS already covers github-actions[bot].
              const botComments = comments
                .filter(c => c.user && BOT_LOGINS.has(c.user.login))
                .sort((a, b) => new Date(b.updated_at) - new Date(a.updated_at));

              for (const c of botComments) {
                if (!READY_REGEX.test(c.body)) continue;
                const m = c.body.match(URL_REGEX);
                if (m) { previewUrl = m[1] || m[0]; break; }
              }

              if (previewUrl) break;
              core.info(`No ready preview yet, polling again in ${POLL_INTERVAL_MS / 1000}s...`);
              await new Promise(r => setTimeout(r, POLL_INTERVAL_MS));
            }

            if (!previewUrl) {
              core.setFailed('Timed out waiting for deco preview comment. Re-run with workflow_dispatch + manual URL to bypass.');
              return;
            }

            core.info(`Found preview URL: ${previewUrl}`);
            core.setOutput('url', previewUrl);

      - name: Resolve target URL
        id: target
        # URLs come from untrusted PR comments — pass via env, never inline ${{ }} into
        # the shell, to avoid command injection (e.g. a backtick-laden preview URL).
        env:
          INPUT_URL: ${{ inputs.url }}
          PREVIEW_URL: ${{ steps.preview.outputs.url }}
        run: |
          if [ -n "$INPUT_URL" ]; then
            echo "url=$INPUT_URL" >> "$GITHUB_OUTPUT"
          else
            echo "url=$PREVIEW_URL" >> "$GITHUB_OUTPUT"
          fi

      - name: Run purchase journey
        if: steps.target.outputs.url
        env:
          TARGET_URL: ${{ steps.target.outputs.url }}
        run: deno task qa:run --url "$TARGET_URL"

      - name: Upload artifacts
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: qa-output-${{ github.event.pull_request.number || github.run_id }}-${{ github.run_attempt }}
          path: |
            junit.xml
            qa-output/
          retention-days: 14

      - name: Publish test report
        if: always() && steps.target.outputs.url
        uses: dorny/test-reporter@v2
        with:
          name: Purchase journey
          path: junit.xml
          reporter: java-junit
          fail-on-error: false
