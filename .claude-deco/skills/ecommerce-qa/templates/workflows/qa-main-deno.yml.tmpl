name: QA (main)

# Runs the @decocms/qa purchase journey against production on push to main.
# The engine (>=0.5.0) sends a `deco-qa-bot/1.0` token in its User-Agent for the
# Cloudflare allowlist. Override the target with workflow_dispatch.url if needed.

on:
  push:
    branches: [main]
  workflow_dispatch:
    inputs:
      url:
        description: Override the URL to test (defaults to .qarc.json url)
        required: false
        type: string

concurrency:
  group: qa-main
  cancel-in-progress: false

jobs:
  e2e:
    name: Purchase journey (prod)
    runs-on: ubuntu-latest
    timeout-minutes: 20

    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Setup Deno
        uses: denoland/setup-deno@v1
        with:
          deno-version: v2.x

      # A push to main only *triggers* the deco prod build/deploy, which runs
      # asynchronously off GitHub Actions (minutes). deco posts a commit status
      # "Deco / <site> / prod" (legacy status API, not a check-run) that flips
      # pending -> success once prod is live. Wait for it so the journey runs
      # against the freshly-deployed prod, not the previous version. The context
      # carries the per-store slug, so match it with a pattern (site-agnostic).
      - name: Wait for deco prod deploy
        if: github.event_name == 'push'
        uses: actions/github-script@v7
        with:
          retries: 3
          script: |
            const SHA = context.sha;
            const TIMEOUT_MS = 20 * 60 * 1000;     // prod builds take a few minutes
            const POLL_INTERVAL_MS = 20_000;
            const PROD_CONTEXT = /^Deco \/ .+ \/ prod$/;
            const deadline = Date.now() + TIMEOUT_MS;
            while (Date.now() < deadline) {
              const { data } = await github.rest.repos.getCombinedStatusForRef({
                owner: context.repo.owner, repo: context.repo.repo, ref: SHA,
              });
              const prod = data.statuses.find(s => PROD_CONTEXT.test(s.context));
              if (prod?.state === 'success') {
                core.info(`deco prod deploy succeeded (${prod.context}).`);
                return;
              }
              if (prod && (prod.state === 'failure' || prod.state === 'error')) {
                core.setFailed(`deco prod deploy ${prod.state} — skipping QA. Logs: ${prod.target_url}`);
                return;
              }
              core.info(prod ? `prod deploy ${prod.state}, polling...` : 'no deco prod status yet, polling...');
              await new Promise(r => setTimeout(r, POLL_INTERVAL_MS));
            }
            core.setFailed('Timed out waiting for the deco prod deploy. Re-run via workflow_dispatch to bypass.');

      # @decocms/qa runs Playwright under Deno but does not ship browser binaries.
      # Install the Chromium build matching the playwright version the engine resolves
      # (its dependency range), so the revision matches what the engine launches.
      - name: Install Playwright browsers (matching engine)
        run: |
          PW=$(npm view @decocms/qa@{{ENGINE_VERSION}} dependencies.playwright)
          echo "Engine playwright range: $PW"
          npx --yes "playwright@$PW" install --with-deps chromium chromium-headless-shell

      - name: Resolve target URL
        id: target
        # Pass the dispatch input via env, never inline ${{ }} into the shell (injection-safe).
        env:
          INPUT_URL: ${{ inputs.url }}
        run: |
          if [ -n "$INPUT_URL" ]; then
            URL="$INPUT_URL"
          else
            URL=$(deno eval "console.log(JSON.parse(await Deno.readTextFile('.qarc.json')).url)")
          fi
          echo "url=$URL" >> "$GITHUB_OUTPUT"

      - name: Run purchase journey
        env:
          TARGET_URL: ${{ steps.target.outputs.url }}
        run: deno task qa:run --url "$TARGET_URL"

      - name: Upload artifacts
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: qa-output-main-${{ github.run_id }}
          path: |
            junit.xml
            qa-output/
          retention-days: 30

      - name: Publish test report
        if: always()
        uses: dorny/test-reporter@v2
        with:
          name: Purchase journey (prod)
          path: junit.xml
          reporter: java-junit
          fail-on-error: false
